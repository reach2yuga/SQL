 -- Use a window function to find a running average over the last 7 days.

 -- Create table
CREATE TABLE daily_sales (
  sale_date DATE PRIMARY KEY,
  sales DECIMAL(10,2)
);

-- Insert sample data (with intentional date gaps)
INSERT INTO daily_sales VALUES
('2023-01-01', 100.00),
('2023-01-02', 150.00),
('2023-01-03', 200.00),  -- Gap: 01-04 missing
('2023-01-05', 250.00),
('2023-01-06', 300.00),
('2023-01-07', 350.00),
('2023-01-08', 400.00),
('2023-01-09', 450.00),
('2023-01-10', 500.00);  -- 10th day (7-day window: 04-10)

SELECT
  sale_date,
  sales,
  AVG(sales) OVER (
    ORDER BY sale_date
    ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
  ) AS avg_sales_7d
FROM daily_sales;


