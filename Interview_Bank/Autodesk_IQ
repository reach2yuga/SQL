--Write a query to find the first purchase made by each user.


-- Create purchases table
CREATE TABLE purchases (
    purchase_id INT PRIMARY KEY,
    user_id INT,
    purchase_date DATE,
    amount DECIMAL(10, 2)
);

-- Insert sample data
INSERT INTO purchases (purchase_id, user_id, purchase_date, amount) VALUES
(101, 1, '2023-01-15', 50.00),
(102, 1, '2023-01-10', 25.00),  -- First purchase for user 1
(103, 2, '2023-02-01', 75.00),
(104, 3, '2023-01-20', 100.00),
(105, 2, '2023-01-25', 30.00),  -- First purchase for user 2
(106, 3, '2023-01-05', 80.00),  -- First purchase for user 3 (earlier than purchase 104)
(107, 1, '2023-01-10', 15.00);  -- Tie for user 1 (same date as purchase 102)

select * from purchases

SELECT user_id, purchase_id, purchase_date, amount
FROM (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY user_id 
            ORDER BY purchase_date, purchase_id
        ) AS purchase_rank
    FROM purchases
) ranked
WHERE purchase_rank = 1;


